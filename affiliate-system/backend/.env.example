# OpenAI
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 処理設定
BATCH_SIZE=50
MAX_WORKERS=4
GENERATE_INTRO=true
INTRO_MAX_CHARS=200

# レートリミット / リトライ
OPENAI_MAX_RETRIES=5
OPENAI_RETRY_BASE_DELAY=1.0
OPENAI_RETRY_MAX_DELAY=60.0
OPENAI_REQUESTS_PER_MINUTE=500

# 入出力パス（backend/ からの相対パス）
RAW_CSV_DIR=data/raw
PROCESSED_JSON_DIR=data/processed
ASP_SOURCE=fanza
