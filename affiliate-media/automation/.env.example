# X (Twitter) API — OAuth 1.0a User Context（投稿に必要）
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_TOKEN_SECRET=your_access_token_secret

# Discord Webhook（稼働状況・エラー通知）
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
DISCORD_NOTIFY_SUCCESS=true

# 商品 JSON パス（Phase 1 出力）
PRODUCTS_JSON_PATH=../backend/data/processed/products.json

# 投稿履歴・ログ
HISTORY_FILE=data/post_history.json
LOG_DIR=data/logs

# 投稿設定
POST_MODE=random
# random | new | high_price
POST_INTERVAL_MINUTES=180
NEW_RELEASE_DAYS=30
MIN_PRICE=2000
MAX_HASHTAGS=3
SITE_URL=
# 自サイト URL（任意）例: https://example.com/products/{slug}

# URL 短縮（任意 — 未設定時はアフィリエイト URL をそのまま使用）
BITLY_ACCESS_TOKEN=

# リトライ
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY=2.0
RETRY_MAX_DELAY=120.0

# 同一作品の再投稿クールダウン（日）
REPOST_COOLDOWN_DAYS=30
